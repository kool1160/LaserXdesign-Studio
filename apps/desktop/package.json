{
  "name": "@laserx/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Secure Windows desktop shell for LaserX Design Studio",
  "author": "LaserX Design Studio contributors",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:electron": "node build.mjs",
    "build:renderer": "vite build",
    "dev": "pnpm build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/electron/main.cjs\"",
    "package:win": "pnpm build && electron-builder --win dir",
    "test": "vitest run",
    "test:e2e": "pnpm package:win && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@laserx/application": "workspace:*",
    "@laserx/cutability": "workspace:*",
    "@laserx/domain": "workspace:*",
    "@laserx/fonts": "workspace:*",
    "@laserx/geometry": "workspace:*",
    "@laserx/io-dxf": "workspace:*",
    "@laserx/io-svg": "workspace:*",
    "@laserx/import-raster": "workspace:*",
    "@laserx/project-format": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "playwright": "1.62.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "studio.laserx.desktop",
    "productName": "LaserX Design Studio",
    "asar": true,
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
