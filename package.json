{
  "name": "laserx-design-studio",
  "version": "0.13.0-beta.1",
  "private": true,
  "description": "Windows-first cut-ready metal sign design studio",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @laserx/desktop dev",
    "build": "pnpm --filter @laserx/project-format build && pnpm --filter @laserx/application build && pnpm --filter @laserx/desktop build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @laserx/desktop test:e2e",
    "audit:fonts": "node scripts/font-license-audit.mjs",
    "audit:geometry": "node scripts/geometry-license-audit.mjs",
    "audit:raster": "node scripts/raster-license-audit.mjs",
    "audit:cutability": "node scripts/cutability-policy-audit.mjs",
    "audit:templates": "node scripts/sign-template-asset-audit.mjs",
    "audit:ai": "node scripts/ai-boundary-audit.mjs",
    "audit:production": "node scripts/production-package-audit.mjs",
    "audit:physical-preview": "node scripts/physical-preview-boundary-audit.mjs",
    "audit:release": "node scripts/release-policy-audit.mjs",
    "audit:signing-policy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-authenticode-policy.ps1",
    "audit:release-gate": "node scripts/test-controlled-beta-release-gate.mjs",
    "generate:raster-fixtures": "pnpm --filter @laserx/desktop exec electron ../../scripts/generate-m07-raster-fixtures.cjs",
    "verify": "pnpm audit:fonts && pnpm audit:geometry && pnpm audit:raster && pnpm audit:cutability && pnpm audit:templates && pnpm audit:ai && pnpm audit:production && pnpm audit:physical-preview && pnpm audit:release && pnpm audit:signing-policy && pnpm audit:release-gate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
