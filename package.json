{
  "name": "laserx-design-studio",
  "version": "0.13.0-beta.1",
  "private": true,
  "description": "Windows-first cut-ready metal sign design studio",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @laserx/desktop dev",
    "build": "pnpm --filter @laserx/project-format build && pnpm --filter @laserx/application build && pnpm --filter @laserx/desktop build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @laserx/desktop test:e2e",
    "audit:fonts": "node scripts/font-license-audit.mjs",
    "audit:geometry": "node scripts/geometry-license-audit.mjs",
    "audit:raster": "node scripts/raster-license-audit.mjs",
    "audit:cutability": "node scripts/cutability-policy-audit.mjs",
    "audit:templates": "node scripts/sign-template-asset-audit.mjs",
    "audit:ai": "node scripts/ai-boundary-audit.mjs",
    "audit:production": "node scripts/production-package-audit.mjs",
    "audit:physical-preview": "node scripts/physical-preview-boundary-audit.mjs",
    "audit:physical-preview-guard": "node scripts/test-physical-preview-boundary-audit.mjs",
    "audit:renderer-source": "node scripts/renderer-source-boundary-audit.mjs",
    "audit:renderer-source-guard": "node scripts/test-renderer-source-boundary-audit.mjs",
    "audit:physical-preview-lazy-load": "node scripts/physical-preview-lazy-load-audit.mjs",
    "audit:physical-preview-lazy-load-guard": "node scripts/test-physical-preview-lazy-load-audit.mjs",
    "audit:repository-guard": "py -3 scripts/test_repository_guard.py",
    "audit:release": "node scripts/release-policy-audit.mjs",
    "audit:signing-policy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-authenticode-policy.ps1",
    "audit:release-gate": "node scripts/test-controlled-beta-release-gate.mjs",
    "generate:raster-fixtures": "pnpm --filter @laserx/desktop exec electron ../../scripts/generate-m07-raster-fixtures.cjs",
    "verify": "pnpm audit:fonts && pnpm audit:geometry && pnpm audit:raster && pnpm audit:cutability && pnpm audit:templates && pnpm audit:ai && pnpm audit:production && pnpm audit:physical-preview && pnpm audit:physical-preview-guard && pnpm audit:renderer-source && pnpm audit:renderer-source-guard && pnpm audit:physical-preview-lazy-load-guard && pnpm audit:repository-guard && pnpm audit:release && pnpm audit:signing-policy && pnpm audit:release-gate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:physical-preview-lazy-load && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0"
  }
}
